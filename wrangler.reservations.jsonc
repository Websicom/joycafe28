{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joycafe28-reservations",
  "main": "workers/reservations.js",
  "compatibility_date": "2026-09-05",
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEpn0qsB3m4FE1kb"
  },
  "send_email": [
    {
      "name": "BOOKING_EMAIL",
      "destination_address": "steff@joycafe28.com",
      "allowed_sender_addresses": ["bookings@joycafe28.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "BOOKING_RATE_LIMITER",
      "namespace_id": "2801",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
